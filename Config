const mysql = require("mysql2");

const dbConfig = {
    host: "localhost",
    user: "root",
    password: "",
    database: "db_perpustakaan"
};

const db = mysql.createConnection(dbConfig);

db.connect((error) => {
    if (error) {
        console.log("Koneksi database gagal!");
        console.error(error);
        return;
    }

    console.log("Berhasil terhubung ke database.");
});

module.exports = db;
